{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fading",
  "main": "./src/framework/entry.rsc.tsx",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": ["nodejs_als"],
  "kv_namespaces": [
    {
      "binding": "DIARY_KV",
      "id": "<KV_NAMESPACE_ID>",
      "preview_id": "<KV_NAMESPACE_PREVIEW_ID>"
    }
  ],
  "route": {
    "pattern": "tkoyasak.dev/lab/fading*",
    "zone_name": "tkoyasak.dev"
  },
  "observability": {
    "enabled": true
  }
}
