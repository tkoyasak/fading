{
  "include": [".react-router/types/**/*", "app/**/*", "worker-configuration.d.ts"],
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": [
      "react/canary",
      "vite/client",
      "@vitejs/plugin-rsc/types",
      "@react-router/dev/rsc-types"
    ],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"]
  }
}
