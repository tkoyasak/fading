{
  "name": "fading-qwik-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "oxfmt",
    "fmt.check": "oxfmt --check",
    "lint": "oxlint && eslint .",
    "serve": "wrangler dev --env dev",
    "qwik": "qwik"
  },
  "dependencies": {
    "marked": "18.0.4",
    "option-t": "56.1.2"
  },
  "devDependencies": {
    "@qwik.dev/core": "2.0.0-beta.34",
    "@qwik.dev/router": "2.0.0-beta.34",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.0",
    "eslint": "10.4.0",
    "eslint-plugin-qwik": "2.0.0-beta.34",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "7.3.2",
    "wrangler": "4.93.0"
  }
}
