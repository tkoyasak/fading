{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["apps/web/worker-configuration.d.ts", "apps/qwik", "apps/qwik-beta"],
  "sortImports": {
    "newlinesBetween": false
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "apps/web/app/global.css"
        }
      }
    }
  ]
}
